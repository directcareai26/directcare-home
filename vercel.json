{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/old-home", "destination": "/", "permanent": true },
    { "source": "/contact-old", "destination": "/contact-us", "permanent": true },
    { "source": "/terms-and-conditions-old", "destination": "/terms-and-conditions", "permanent": true },
    { "source": "/safety-policy", "destination": "/safety", "permanent": true },
    { "source": "/about-us", "destination": "/about", "permanent": true },
    { "source": "/contact", "destination": "/contact-us", "permanent": true },
    { "source": "/journeys", "destination": "/products", "permanent": true },
    { "source": "/blogs", "destination": "/", "permanent": false },
    { "source": "/blog", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/start-hrt", "destination": "/hormone-replacement-therapy" },
    { "source": "/start-hrt/", "destination": "/hormone-replacement-therapy" },

    { "source": "/start-trt", "destination": "/testosterone-replacement-therapy" },
    { "source": "/start-trt/", "destination": "/testosterone-replacement-therapy" },

    { "source": "/blood-labs", "destination": "/blood-test" },
    { "source": "/blood-labs/", "destination": "/blood-test" },

    { "source": "/rpm", "destination": "/remote-patient-monitoring" },
    { "source": "/rpm/", "destination": "/remote-patient-monitoring" },

    { "source": "/patients", "destination": "/patient" },
    { "source": "/patients/", "destination": "/patient" },

    { "source": "/womens-health", "destination": "https://women.directcare.ai/womens-health/" },
    { "source": "/womens-health/", "destination": "https://women.directcare.ai/womens-health/" },
    { "source": "/womens-health/:path*", "destination": "https://women.directcare.ai/womens-health/:path*" },

    { "source": "/mens-health", "destination": "https://mens.directcare.ai/mens-health/" },
    { "source": "/mens-health/", "destination": "https://mens.directcare.ai/mens-health/" },
    { "source": "/mens-health/:path*", "destination": "https://mens.directcare.ai/mens-health/:path*" },

    { "source": "/mens-hair-loss", "destination": "https://mens-hair-loss.vercel.app/" },
    { "source": "/mens-hair-loss/", "destination": "https://mens-hair-loss.vercel.app/" },
    { "source": "/mens-hair-loss/:path*", "destination": "https://mens-hair-loss.vercel.app/:path*" },

    { "source": "/womans-hair-loss", "destination": "https://womens-hair-loss.vercel.app/" },
    { "source": "/womans-hair-loss/", "destination": "https://womens-hair-loss.vercel.app/" },
    { "source": "/womans-hair-loss/:path*", "destination": "https://womens-hair-loss.vercel.app/:path*" },

    { "source": "/surge-max", "destination": "https://sexual-health-mocha.vercel.app/" },
    { "source": "/surge-max/", "destination": "https://sexual-health-mocha.vercel.app/" },
    { "source": "/surge-max/:path*", "destination": "https://sexual-health-mocha.vercel.app/:path*" },

    { "source": "/weight-loss", "destination": "https://directcare-weight-loss.vercel.app/" },
    { "source": "/weight-loss/", "destination": "https://directcare-weight-loss.vercel.app/" },
    { "source": "/weight-loss/:path*", "destination": "https://directcare-weight-loss.vercel.app/:path*" }
  ]
}
